{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/session-start-learnings.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/pre-config-protect.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/pre-bash-destructive-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/pre-fetch-cache.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/observe.sh pre",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/observe.sh post",
            "async": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/post-bash-output-filter.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/post-edit-accumulate.sh",
            "async": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/post-task-create.sh",
            "async": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/post-fetch-cache.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/pre-model-switch.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/post-model-switch.sh",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/pre-compact.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/stop-format-typecheck.sh",
            "timeout": 90
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/stop-notify.sh",
            "async": true,
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/stop-debug-check.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/stop-learn-distill.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/observe.sh stop",
            "async": true,
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${ANTIGRAVITY_PLUGIN_ROOT}/hooks/stop-metrics.sh",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
